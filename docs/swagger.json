{
    "swagger": "2.0",
    "info": {
        "description": "High-performance, production-ready RESTful API in Golang to query GitHub pinned repositories with Swagger UI.",
        "title": "GitHub Pinned Repositories API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "https://github.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/pinned/{username}": {
            "get": {
                "description": "Retrieve pinned repositories for a specific GitHub user or organization",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pinned"
                ],
                "summary": "Get GitHub pinned repositories",
                "parameters": [
                    {
                        "type": "string",
                        "example": "torvalds",
                        "description": "GitHub username or organization name",
                        "name": "username",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "Force scrape and bypass cache",
                        "name": "refresh",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.ApiResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Check API service health status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.ApiResponse": {
            "type": "object",
            "properties": {
                "cached": {
                    "type": "boolean",
                    "example": false
                },
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.PinnedRepo"
                    }
                },
                "message": {
                    "type": "string",
                    "example": "Successfully fetched pinned repositories"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                },
                "total": {
                    "type": "integer",
                    "example": 6
                }
            }
        },
        "model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "404 Not Found"
                },
                "message": {
                    "type": "string",
                    "example": "User not found or has no pinned repositories"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "model.PinnedRepo": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Random digital audio effects"
                },
                "forks": {
                    "type": "integer",
                    "example": 217
                },
                "forksDisplay": {
                    "type": "string",
                    "example": "217"
                },
                "isFork": {
                    "type": "boolean",
                    "example": false
                },
                "language": {
                    "type": "string",
                    "example": "C"
                },
                "languageColor": {
                    "type": "string",
                    "example": "#555555"
                },
                "link": {
                    "type": "string",
                    "example": "https://github.com/torvalds/AudioNoise"
                },
                "owner": {
                    "type": "string",
                    "example": "torvalds"
                },
                "repo": {
                    "type": "string",
                    "example": "AudioNoise"
                },
                "stars": {
                    "type": "integer",
                    "example": 4500
                },
                "starsDisplay": {
                    "type": "string",
                    "example": "4.5k"
                }
            }
        }
    }
}